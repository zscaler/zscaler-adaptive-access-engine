{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "baseName": {
        "type": "string",
        "metadata": {
          "description": "Base name for all resources (e.g., 'my-app-prod')."
        }
      },
      "location": {
        "type": "string",
        "defaultValue": "eastus",
        "metadata": {
          "description": "The Azure region where the main resources will be deployed."
        }
      },
      "logicAppLocation": {
        "type": "string",
        "defaultValue": "eastus",
        "metadata": {
          "description": "The Azure region for the Logic App and its API Connections. Defaults to the main location."
        }
      },
      "resourceGroupName": {
        "type": "string",
        "defaultValue": "zscaler-aae",
        "metadata": {
          "description": "The name of the resource group. Used for referencing but not created within this template."
        }
      },
      "allowedIpAddresses": {
        "type": "array",
        "defaultValue": [ "54.81.126.159",
        "34.232.89.148",
        "44.221.241.232",
        "44.238.108.254",
        "52.32.35.254",
        "35.162.38.214",
        "3.77.196.85",
        "3.123.144.88",
        "3.124.174.255",
        "13.36.73.15",
        "15.236.162.60",
        "15.236.246.90"],
        "metadata": {
          "description": "Array of IP address masks (e.g., '10.0.0.0/24') to allow access to the Key Vault. Applies only if publicNetworkAccess is 'Enabled' and defaultAction is 'Deny'."
        }
      },
      "logicAppConnectorIpsEastus": {
        "type": "array",
        "defaultValue": [  "20.62.210.48/32",
        "20.88.153.176/28",
        "20.88.153.192/27",
        "40.71.11.80/28",
        "40.71.15.160/27",
        "40.71.193.203/32",
        "40.71.249.139/32",
        "40.71.249.205/32",
        "40.114.40.132/32",
        "52.151.217.66/32",
        "52.151.217.109/32",
        "52.151.220.217/32",
        "52.151.221.119/32",
        "52.151.221.184/32",
        "104.41.132.180/32"],
        "metadata": {
          "description": "Array of IP rule objects for Event Hub, e.g., [{'ipMask': '1.2.3.4/32', 'action': 'Allow'}]."
        }
      },
      "defenderClientId": {
        "type": "securestring",
        "metadata": {
          "description": "The Client ID for the Defender API, to be stored in Key Vault."
        }
      },
      "defenderClientSecret": {
        "type": "securestring",
        "metadata": {
          "description": "The Client Secret for the Defender API, to be stored in Key Vault."
        }
      },
      "defenderTenantId": {
        "type": "string",
        "metadata": {
          "description": "The Azure Active Directory Tenant ID for Defender API OAuth."
        }
      },
      "logicAppTriggerFrequency": {
        "type": "string",
        "defaultValue": "Minute",
        "allowedValues": ["Minute", "Hour", "Day", "Week", "Month"],
        "metadata": {
          "description": "The frequency for the Logic App recurrence trigger."
        }
      },
      "logicAppTriggerInterval": {
        "type": "int",
        "defaultValue": 5,
        "metadata": {
          "description": "The interval for the Logic App recurrence trigger."
        }
      },
      "deployerObjectId": {
        "type": "string",
        "metadata": {
          "description": "The Object ID (principalId) of the identity deploying this template (e.g., Terraform service principal or user) to grant Key Vault access for secret creation."
        }
      }
    },
    "variables": {
      "keyVaultName": "[format('{0}-keyvault', parameters('baseName'))]",
      "eventhubNamespaceName": "[format('{0}-ns', parameters('baseName'))]",
      "logicAppName": "[format('{0}-logicapp', parameters('baseName'))]",
      "eventhubName": "[format('{0}-evh', parameters('baseName'))]",
      "apiConnectionKeyVaultName": "[concat('api-keyvault-', parameters('baseName'))]",
      "apiConnectionEventHubName": "[concat('api-eventhubs-', parameters('baseName'))]",
      "eventHubEndpoint": "[format('sb://{0}.servicebus.windows.net', variables('eventhubNamespaceName'))]",
      "combinedAllowedIpAddresses": "[concat(parameters('allowedIpAddresses'), parameters('logicAppConnectorIpsEastus'))]",
      "generatedIpRules": ["for ip in variables('combinedAllowedIpAddresses'): {'value': ip}"],
      "keyVaultIpRules": "[if(empty(variables('combinedAllowedIpAddresses')), createArray(), variables('generatedIpRules'))]",
      "keyVaultSecretsOfficerRoleId": "b86a8fe4-44ce-4948-aee5-eccb2c155cd7",
      "keyVaultSecretsUserRoleId": "4633458b-17de-408a-b874-0604847596ba",
      "keyVaultSecretsUserRoleForRBACId": "4633458b-17de-408a-b874-0445c86b69e6",
      "eventHubsDataSenderRoleId": "2b629674-e913-4c01-ae53-ef462ff760ba",  
      "contributorRoleId": "b24988ac-6180-42a0-ab88-20f7382dd24c",         
      "eventhubsManagedApiId": "[format('/subscriptions/{0}/providers/Microsoft.Web/locations/{1}/managedApis/eventhubs', subscription().id, parameters('logicAppLocation'))]",
      "keyvaultManagedApiId": "[format('/subscriptions/{0}/providers/Microsoft.Web/locations/{1}/managedApis/keyvault', subscription().id, parameters('logicAppLocation'))]"
    },
    "resources": [
      {
        "type": "Microsoft.EventHub/namespaces",
        "apiVersion": "2021-11-01",
        "name": "[variables('eventhubNamespaceName')]",
        "location": "[parameters('location')]",
        "sku": {
          "name": "Standard",
          "capacity": 1
        },
        "properties": {
          "minimumTlsVersion": "1.2",
          "publicNetworkAccessEnabled": true,
          "localAuthenticationEnabled": true,
          "isAutoInflateEnabled": true,
          "maximumThroughputUnits": 4,
          "networkRuleSets": {
            "defaultAction": "Deny",
            "trustedServiceAccessEnabled": true,
            "publicNetworkAccess": true,
            "ipRules": "[variables('combinedAllowedIpAddresses')]"
          }
        }
      },
      {
        "type": "Microsoft.EventHub/namespaces/eventhubs",
        "apiVersion": "2021-11-01",
        "name": "[format('{0}/{1}', variables('eventhubNamespaceName'), variables('eventhubName'))]",
        "dependsOn": [
          "[resourceId('Microsoft.EventHub/namespaces', variables('eventhubNamespaceName'))]"
        ],
        "properties": {
          "partitionCount": 1,
          "messageRetentionInDays": 1,
          "status": "Active"
        }
      },
      {
        "type": "Microsoft.EventHub/namespaces/authorizationRules",
        "apiVersion": "2021-11-01",
        "name": "[format('{0}/zsaae-sas-policy', variables('eventhubNamespaceName'))]",
        "dependsOn": [
          "[resourceId('Microsoft.EventHub/namespaces', variables('eventhubNamespaceName'))]"
        ],
        "properties": {
          "rights": [ "Listen", "Send", "Manage" ]
        }
    },
      {
        "type": "Microsoft.EventHub/namespaces/eventhubs/authorizationRules",
        "apiVersion": "2021-11-01",
        "name": "[format('{0}/{1}/zs-aae-listen-policy', variables('eventhubNamespaceName'), variables('eventhubName'))]",
        "dependsOn": [
          "[resourceId('Microsoft.EventHub/namespaces/eventhubs', variables('eventhubNamespaceName'), variables('eventhubName'))]"
        ],
        "properties": {
          "rights": [ "Listen" ]
        }
      },
      {
        "type": "Microsoft.KeyVault/vaults",
        "apiVersion": "2023-07-01",
        "name": "[variables('keyVaultName')]",
        "location": "[parameters('location')]",
        "properties": {
          "sku": {
            "family": "A",
            "name": "standard"
          },
          "tenantId": "[subscription().tenantId]",
          "softDeleteRetentionInDays": 90,
          "enablePurgeProtection": true,
          "enabledForTemplateDeployment": false,
          "enableRbacAuthorization": true,
          "publicNetworkAccess": "enabled",
          "NetworkRuleSet": {
            "bypass": "None",
            "defaultAction": "Allow",
          "ipRules": "[parameters('logicAppConnectorIpsEastus')]",
            "virtualNetworkRules": []
          }
          // ,
          // "accessPolicies": [
          //   {
          //     "tenantId": "[subscription().tenantId]",
          //     "objectId": "[parameters('deployerObjectId')]",
          //     "permissions": {
          //       "secrets": ["Get", "List", "Set", "Delete"]
          //     }
          //   }
          // ]
        }
      },
      {
        "type": "Microsoft.KeyVault/vaults/secrets",
        "apiVersion": "2023-07-01",
        "name": "[format('{0}/DEFENDER-CLIENT-ID', variables('keyVaultName'))]",
        "dependsOn": [
          "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
          "[concat('Microsoft.Authorization/roleAssignments/', guid(variables('keyVaultName'), parameters('deployerObjectId'), variables('keyVaultSecretsOfficerRoleId')))]"
        ],
        "properties": {
          "value": "[parameters('defenderClientId')]"
        }
      },
      {
        "type": "Microsoft.KeyVault/vaults/secrets",
        "apiVersion": "2023-07-01",
        "name": "[format('{0}/DEFENDER-CLIENT-SECRET', variables('keyVaultName'))]",
        "dependsOn": [
          "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
          "[concat('Microsoft.Authorization/roleAssignments/', guid(variables('keyVaultName'), parameters('deployerObjectId'), variables('keyVaultSecretsOfficerRoleId')))]"
        ],
        "properties": {
          "value": "[parameters('defenderClientSecret')]"
        }
      },
      {
        "type": "Microsoft.Web/connections",
        "apiVersion": "2018-07-01-preview",
        "name": "[variables('apiConnectionEventHubName')]",
        "location": "[parameters('logicAppLocation')]",
        "properties": {
          "displayName": "[variables('apiConnectionEventHubName')]",
          "api": {
            "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/eventhubs')]"
          },
          "parameterValueSet": {
            "name": "managedIdentityAuth",
            "values": {
                "namespaceEndpoint": {
                    "value": "[variables('eventHubEndpoint')]"
                },
                "token": {}
            }
          }
        },
        "dependsOn": [
            "[resourceId('Microsoft.EventHub/namespaces', variables('eventhubNamespaceName'))]"
          ]
      },
      {
        "type": "Microsoft.Web/connections",
        "apiVersion": "2018-07-01-preview",
        "name": "[variables('apiConnectionKeyVaultName')]",
        "location": "[parameters('logicAppLocation')]",
        "properties": {
          "displayName": "[variables('apiConnectionKeyVaultName')]",
          "api": {
            "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/keyvault')]"
          },
          "parameterValueSet": {
            "name": "oauthMI",
            "values": {
                "vaultName": {
                    "value": "[variables('keyVaultName')]"
                },
                "token": {}
            }
          }
        },
        "dependsOn": [
          "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
        ]
      },
      {
          "type": "Microsoft.Logic/workflows",
          "apiVersion": "2019-05-01",
          "name": "[variables('logicAppName')]",
          "location": "[parameters('logicAppLocation')]",
          "identity": {
                  "type": "SystemAssigned"
                },
                "dependsOn": [ 
                "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
                "[resourceId('Microsoft.EventHub/namespaces', variables('eventhubNamespaceName'))]",
                "[resourceId('Microsoft.Web/connections', variables('apiConnectionEventHubName'))]",
                "[resourceId('Microsoft.Web/connections', variables('apiConnectionKeyVaultName'))]"

              ],
          "properties": {
            "state": "Enabled",
            "definition": {
              "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
              "contentVersion": "1.0.0.0",
              "parameters": {
                "$connections": {
                  "defaultValue": {},
                  "type": "Object"
                },
                "SCOPE-API": {
                  "defaultValue": "https://api.securitycenter.microsoft.com/.default",
                  "type": "String"
                }
              },
              "triggers": {
                "Recurrence": {
                  "recurrence": {
                    "frequency": "[parameters('logicAppTriggerFrequency')]",
                    "interval": "[parameters('logicAppTriggerInterval')]"
                  },
                  "type": "Recurrence"
                }
              },
              "actions": {
                "Get_Client_Id": {
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['keyvault']['connectionId']"
                      }
                    },
                    "method": "get",
                    "path": "/secrets/@{encodeURIComponent('DEFENDER-CLIENT-ID')}/value"
                  },
                  "runAfter": {},
                  "type": "ApiConnection"
                },
                "Get_Client_Secret": {
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['keyvault']['connectionId']"
                      }
                    },
                    "method": "get",
                    "path": "/secrets/@{encodeURIComponent('DEFENDER-CLIENT-SECRET')}/value"
                  },
                  "runAfter": {
                    "Get_Client_Id": ["Succeeded"]
                  },
                  "type": "ApiConnection"
                },
                "Get_Oauth_Token": {
                  "inputs": {
                    "body": "grant_type=client_credentials&\nclient_id=@{body('Get_Client_Id')?['value']}&\nclient_secret=@{body('Get_Client_Secret')?['value']}&\nscope=@{parameters('SCOPE-API')}",
                    "headers": {
                      "Content-Type": "application/x-www-form-urlencoded"
                    },
                    "method": "POST",
                    "uri": "[format('https://login.microsoftonline.com/{0}/oauth2/v2.0/token', parameters('defenderTenantId'))]"
                  },
                  "runAfter": {
                    "Get_Client_Secret": ["Succeeded"]
                  },
                  "type": "Http"
                },
                "Get_Machines": {
                  "inputs": {
                    "headers": {
                      "Authorization": "Bearer @{body('Get_Oauth_Token')['access_token']}"
                    },
                    "method": "GET",
                    "uri": "https://api.security.microsoft.com/api/machines"
                  },
                  "runAfter": {
                    "Get_Oauth_Token": ["Succeeded"]
                  },
                  "type": "Http"
                },
                "Send_event": {
                  "inputs": {
                    "body": {
                      "ContentData": "@base64(body('Get_Machines'))"
                    },
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['eventhubs']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "[format('/{0}/events', variables('eventhubName'))]"
                  },
                  "runAfter": {
                    "Get_Machines": ["Succeeded"]
                  },
                  "type": "ApiConnection"
                }
              },
              "outputs": {}
            },
            "parameters": {
              "$connections": {
                "type": "Object",
                "value": {
                  "keyvault": {
                    "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/',parameters('logicAppLocation'), '/managedApis/keyvault')]",
                    "connectionName": "[variables('apiConnectionKeyVaultName')]",
                    "connectionId":  "[concat('/subscriptions/', subscription().subscriptionId, '/resourceGroups/', resourceGroup().name, '/providers/Microsoft.Web/connections/', variables('apiConnectionKeyVaultName'))]",
                    "connectionProperties": {
                      "authentication": {
                          "type": "ManagedServiceIdentity"
                      }
                    }
                  },
                  "eventhubs": {
                    "id":  "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/',parameters('logicAppLocation'), '/managedApis/eventhubs')]",
                    "connectionName": "[variables('apiConnectionEventHubName')]",
                    "connectionId":  "[concat('/subscriptions/', subscription().subscriptionId, '/resourceGroups/', resourceGroup().name, '/providers/Microsoft.Web/connections/', variables('apiConnectionEventHubName'))]",
                    "connectionProperties": {
                      "authentication": {
                          "type": "ManagedServiceIdentity"
                      }
                    }
                  }
                }
              }
            }
          }
        },
      //   {
      //   "type": "Microsoft.KeyVault/vaults/accessPolicies",
      //   "apiVersion": "2023-07-01",
      //   "name": "[format('{0}/add', variables('keyVaultName'))]",
      //   "dependsOn": [
      //     "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
      //     "[resourceId('Microsoft.Logic/workflows', variables('logicAppName'))]"
      //   ],
      //   "properties": {
      //     "accessPolicies": [
      //       {
      //         "tenantId": "[subscription().tenantId]",
      //         "objectId": "[reference(resourceId('Microsoft.Logic/workflows', variables('logicAppName')), '2019-05-01', 'Full').identity.principalId]",
      //         "permissions": {
      //           "secrets": ["Get", "List"]
      //         }
      //       }
      //     ]
      //   }
      // },
      {
        "type": "Microsoft.Authorization/roleAssignments",
        "apiVersion": "2022-04-01",
        "name": "[guid(variables('eventhubNamespaceName'), variables('logicAppName'), variables('eventHubsDataSenderRoleId'))]",
        "dependsOn": [
          "[resourceId('Microsoft.EventHub/namespaces', variables('eventhubNamespaceName'))]",
          "[resourceId('Microsoft.Logic/workflows', variables('logicAppName'))]"
        ],
        "properties": {
          "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '2b629674-e913-4c01-ae53-ef4638d8f975')]",
          "principalId": "[reference(resourceId('Microsoft.Logic/workflows', variables('logicAppName')), '2019-05-01', 'Full').identity.principalId]",
          "principalType": "ServicePrincipal"
        }
      },     
       {
        "type": "Microsoft.Authorization/roleAssignments",
        "apiVersion": "2022-04-01",
        "name": "[guid(variables('keyVaultName'), parameters('deployerObjectId'), variables('keyVaultSecretsOfficerRoleId'))]",
        "scope": "[format('Microsoft.KeyVault/vaults/{0}', variables('keyVaultName'))]",
        "dependsOn": [
          "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
        ],
        "properties": {
          "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultSecretsOfficerRoleId'))]",
          "principalId": "[parameters('deployerObjectId')]"
        }
      },
      {
        "type": "Microsoft.Authorization/roleAssignments",
        "apiVersion": "2022-04-01",
        "name": "[guid(variables('keyVaultName'), variables('logicAppName'), variables('keyVaultSecretsUserRoleForRBACId'))]",
        "scope": "[format('Microsoft.KeyVault/vaults/{0}', variables('keyVaultName'))]",
        "dependsOn": [
          "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
          "[resourceId('Microsoft.Logic/workflows', variables('logicAppName'))]"
        ],
        "properties": {
          "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultSecretsUserRoleForRBACId'))]",
          "principalId": "[reference(resourceId('Microsoft.Logic/workflows', variables('logicAppName')), '2019-05-01', 'Full').identity.principalId]",
          "principalType": "ServicePrincipal"
        }
      }
    ]
  }